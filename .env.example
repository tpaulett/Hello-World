PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
PLAID_ENV=sandbox
PORT=3000
USE_MOCK_MODE=true

# RateAPI (https://rateapi.dev) — server-side only, never exposed to the browser.
# Leave RATEAPI_KEY empty to run the dashboard on built-in sample data.
RATEAPI_KEY=
RATEAPI_BASE=https://api.rateapi.dev
RATES_PORT=3100
# Force sample data even when a key is present.
RATEAPI_SAMPLE=false
